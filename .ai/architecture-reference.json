{
  "commandTree": {
    "root": "zapi-cli [--account <name>] [--json] [--no-input] [--help] [--version]",
    "groups": {
      "account": {
        "subcommands": [
          { "name": "add",         "flags": ["--name (req)", "--auth-type pat (req)", "--token (req for pat)", "--domain (default: zoho.com)"] },
          { "name": "list",        "flags": [] },
          { "name": "remove",      "flags": ["--name (req)"] },
          { "name": "show",        "flags": ["--name (req)"] },
          { "name": "set-default", "flags": ["--name (req)"] },
          { "name": "re-auth",     "flags": ["--name (req)"], "note": "stub in v1 — returns NOT_IMPLEMENTED" }
        ]
      },
      "scope": {
        "subcommands": [
          { "name": "add",    "flags": ["--scope (req)", "--account (optional)"] },
          { "name": "remove", "flags": ["--scope (req)", "--account (optional)"] },
          { "name": "list",   "flags": ["--account (optional)"] }
        ]
      },
      "api": {
        "subcommands": [
          {
            "name": "call",
            "flags": [
              "--base-url <url> (req — caller-supplied, no derivation)",
              "--method GET|POST|PUT|PATCH|DELETE (req)",
              "--path <string> (req)",
              "--body <json-string> (mutually exclusive with --body-file)",
              "--body-file <path> (mutually exclusive with --body)",
              "--header key:value (repeatable)",
              "--query key=value (repeatable)",
              "--account <name> (optional override)"
            ],
            "note": "Final URL assembled as <base-url><path>. --base-url is required every invocation, no product/datacenter derivation."
          },
          { "name": "registry add",    "flags": ["--id (req)", "--base-url (req)", "--method (req)", "--url-template (req)", "--purpose (req)"], "version": "v2" },
          { "name": "registry list",   "flags": [],                   "version": "v2" },
          { "name": "registry show",   "flags": ["--id (req)"],        "version": "v2" },
          { "name": "registry remove", "flags": ["--id (req)"],        "version": "v2" }
        ]
      },
      "trace": {
        "subcommands": [
          { "name": "session start",  "flags": ["--name (req)"] },
          { "name": "session list",   "flags": [] },
          { "name": "session export", "flags": ["--name (req)", "--truncate-body <bytes> (optional)", "--type api|pex (optional)"] },
          { "name": "session close",  "flags": ["--name (req)"] },
          { "name": "session remove", "flags": ["--name (req)"] }
        ]
      },
      "pex": {
        "version": "v2",
        "subcommands": [
          { "name": "connect", "flags": ["--account (optional)"] },
          { "name": "send",    "flags": ["--message (req)", "--account (optional)"] },
          { "name": "drain",   "flags": ["--account (optional)"] },
          { "name": "clear",   "flags": ["--account (optional)"] },
          { "name": "listen",  "flags": ["--account (optional)"] },
          { "name": "close",   "flags": ["--account (optional)"] }
        ]
      },
      "ws": {
        "version": "v2",
        "subcommands": [
          { "name": "connect", "flags": ["--url (req)", "--name (req)", "--account (optional)"] },
          { "name": "send",    "flags": ["--name (req)", "--message (req)"] },
          { "name": "listen",  "flags": ["--name (req)"] },
          { "name": "close",   "flags": ["--name (req)"] }
        ]
      },
      "util": {
        "subcommands": [
          { "name": "time-ms", "description": "Current UTC time as Unix millisecond timestamp" },
          { "name": "uuid",    "description": "Generate a random UUID v4" }
        ]
      }
    }
  },
  "interfaces": {
    "IKeychainProvider": {
      "namespace": "ZapiCli.Keychain",
      "methods": [
        "Task<string?> GetAsync(string key, CancellationToken ct = default)",
        "Task SetAsync(string key, string value, CancellationToken ct = default)",
        "Task DeleteAsync(string key, CancellationToken ct = default)"
      ],
      "keyFormat": "zapi-cli:<accountName>:<tokenType>",
      "keyExample": "zapi-cli:work:pat",
      "implementations": [
        { "class": "MacOsKeychainProvider",         "backend": "Security.framework via P/Invoke" },
        { "class": "WindowsKeychainProvider",       "backend": "advapi32.dll CredWrite/CredRead via P/Invoke" },
        { "class": "LinuxKeychainProvider",         "backend": "libsecret Secret Service via P/Invoke" },
        { "class": "EncryptedFileKeychainProvider", "backend": "AES-256-GCM, key from machine entropy; path: <configDir>/keystore/<accountName>.bin" }
      ]
    },
    "IAuthProvider": {
      "namespace": "ZapiCli.Core.Auth",
      "methods": [
        "Task<string> GetTokenAsync(string accountName, CancellationToken ct = default)",
        "Task StoreTokenAsync(string accountName, string token, CancellationToken ct = default)",
        "Task ClearTokenAsync(string accountName, CancellationToken ct = default)"
      ],
      "v1Implementation": "PatAuthProvider",
      "v2Implementation": "OAuthProvider",
      "note": "ApiClient calls IAuthProvider.GetTokenAsync() — never IKeychainProvider directly. OAuth client_id/client_secret are compile-time constants in OAuthProvider — never user-supplied."
    },
    "IAccountStore": {
      "namespace": "ZapiCli.Core.Accounts",
      "methods": [
        "Task<AccountsRoot> LoadAsync(CancellationToken ct = default)",
        "Task SaveAsync(AccountsRoot root, CancellationToken ct = default)",
        "Task<AccountEntry?> FindAsync(string name, CancellationToken ct = default)",
        "Task<AccountEntry> GetDefaultAsync(CancellationToken ct = default)"
      ]
    },
    "IOutputWriter": {
      "namespace": "ZapiCli.Core",
      "purpose": "All output goes through this — commands NEVER write to Console directly",
      "methods": [
        "void WriteSuccess(object data)",
        "void WriteError(string message, string code, int exitCode)"
      ]
    }
  },
  "dataModels": {
    "AccountEntry": {
      "namespace": "ZapiCli.Core.Accounts",
      "type": "sealed record",
      "properties": [
        { "name": "Name",        "type": "required string",    "jsonKey": "name" },
        { "name": "Domain",      "type": "required string",    "jsonKey": "domain",       "example": "zoho.com" },
        { "name": "Email",       "type": "string?",            "jsonKey": "email",        "note": "populated from Zoho user-info API at account add" },
        { "name": "Scopes",      "type": "List<string>",       "jsonKey": "scopes",       "default": "[]" },
        { "name": "TokenType",   "type": "required string",    "jsonKey": "token_type",   "values": ["pat", "oauth"] },
        { "name": "IsDefault",   "type": "bool",               "jsonKey": "is_default" },
        { "name": "NeedsReauth", "type": "bool",               "jsonKey": "needs_reauth" }
      ]
    },
    "AccountsRoot": {
      "namespace": "ZapiCli.Core.Accounts",
      "type": "sealed record",
      "properties": [
        { "name": "Accounts", "type": "List<AccountEntry>", "jsonKey": "accounts", "default": "[]" }
      ]
    },
    "ApiRequest": {
      "namespace": "ZapiCli.Core.Api",
      "type": "sealed record",
      "properties": [
        { "name": "BaseUrl",     "type": "required string",                "note": "caller-supplied, validated against host allowlist" },
        { "name": "Method",      "type": "required string" },
        { "name": "Path",        "type": "required string" },
        { "name": "Body",        "type": "string?" },
        { "name": "Headers",     "type": "Dictionary<string, string>",     "default": "[]" },
        { "name": "QueryParams", "type": "Dictionary<string, string>",     "default": "[]" },
        { "name": "AccountName", "type": "required string" }
      ]
    },
    "ApiResponse": {
      "namespace": "ZapiCli.Core.Api",
      "type": "sealed record",
      "properties": [
        { "name": "StatusCode", "type": "int" },
        { "name": "Body",       "type": "required string", "note": "raw JSON string from server" },
        { "name": "IsSuccess",  "type": "bool", "computed": "StatusCode is >= 200 and < 300" }
      ]
    },
    "ApiTraceEntry": {
      "namespace": "ZapiCli.Core.Trace",
      "type": "sealed record",
      "typeValue": "api",
      "properties": [
        "int Seq", "string Type (=> \"api\")", "required string Session",
        "required DateTimeOffset Timestamp", "int DurationMs", "required string Account",
        "required string Method", "required string BaseUrl", "required string Url",
        "Dictionary<string, string> RequestHeaders (Authorization EXCLUDED)",
        "string? RequestBody", "int ResponseStatus",
        "Dictionary<string, string> ResponseHeaders", "string? ResponseBody",
        "string? Error (non-null on transport failure only)"
      ]
    },
    "PexTraceEntry": {
      "namespace": "ZapiCli.Core.Trace",
      "type": "sealed record",
      "typeValue": "pex",
      "note": "v2 — Pex/WMS event buffering",
      "properties": [
        "int Seq", "string Type (=> \"pex\")", "required string Session",
        "required DateTimeOffset Timestamp", "required string Account",
        "int? RelatedApiSeq", "required string HandlerClass",
        "required string CallbackMethod", "required string Payload"
      ]
    },
    "ApiRegistryEntry": {
      "namespace": "ZapiCli.Core.Registry",
      "type": "sealed record",
      "note": "v2 — API Registry catalogue",
      "properties": [
        "required string Id", "required string BaseUrl", "required string Method",
        "required string UrlTemplate", "required string Purpose"
      ]
    }
  },
  "outputContract": {
    "stdout": "{ \"status\": \"ok\", \"data\": <result> }",
    "stderr": "{ \"error\": \"<message>\", \"code\": \"<CODE>\", \"exitCode\": <1|2> }",
    "exitCodes": { "0": "success", "1": "general error or security block", "2": "auth failure / needs-reauth" },
    "tokenRule": "Token values NEVER appear in any output or trace file. account show renders \"token\": \"***\".",
    "errorCodes": [
      { "code": "ACCOUNT_NOT_FOUND",      "exit": 1 },
      { "code": "ACCOUNT_DOMAIN_BLOCKED", "exit": 1 },
      { "code": "AUTH_FAILURE",           "exit": 2 },
      { "code": "NEEDS_REAUTH",           "exit": 2 },
      { "code": "HOST_NOT_ALLOWED",       "exit": 1 },
      { "code": "INVALID_ARGS",           "exit": 1 },
      { "code": "SESSION_NOT_FOUND",      "exit": 1 },
      { "code": "SCOPE_NOT_FOUND",        "exit": 1 },
      { "code": "REGISTRY_ENTRY_NOT_FOUND", "exit": 1 },
      { "code": "NOT_IMPLEMENTED",        "exit": 1 }
    ]
  },
  "securityRules": {
    "zohocorpBlock": {
      "detection": "email.Split('@')[1].Split('.')[0].Equals(\"zohocorp\", StringComparison.OrdinalIgnoreCase)",
      "enforcedIn": ["AccountStore (at account add, before keychain write)", "ApiClient.CallAsync (before HTTP dispatch)"],
      "alsoEnforcedIn": "All scope subcommands — account resolved first, block fires before any mutation",
      "errorCode": "ACCOUNT_DOMAIN_BLOCKED",
      "override": "NONE — compile-time constant, no flag, env var, or config allows bypass",
      "startupWarning": "Emitted to stderr if accounts.json contains a ZohoCorp-domain legacy entry"
    },
    "hostAllowlist": {
      "allowedSuffixes": [".zoho.com", ".zoho.eu", ".zoho.in", ".zoho.com.au", ".zohoapis.com", ".zohoapis.in"],
      "enforcedIn": "ApiClient.CallAsync — before any TCP connection or token read from keychain",
      "errorCode": "HOST_NOT_ALLOWED",
      "override": "NONE — static readonly sealed array in ZapiCli.Core, not extensible at runtime"
    }
  },
  "authFlow": {
    "v1Pat": {
      "step1": "zapi-cli account add --name 'work' --auth-type pat --token 'xxx'",
      "step2": "Call Zoho user-info API (GET https://accounts.{domain}/oauth/user/info) to retrieve email; perform ZohoCorp check",
      "step3": "PatAuthProvider.StoreTokenAsync('work', 'xxx') → IKeychainProvider.SetAsync('zapi-cli:work:pat', 'xxx')",
      "step4": "Append AccountEntry (no token) to accounts.json with 0600 perms",
      "injection": "ApiClient calls IAuthProvider.GetTokenAsync(), injects 'Authorization: Zoho-oauthtoken <token>'"
    }
  },
  "baseUrlResolution": {
    "pattern": "Caller supplies full --base-url on every api call invocation",
    "assembly": "Final URL = <base-url><path> (no normalization, no derivation from account domain)",
    "examples": [
      { "baseUrl": "https://cliq.zoho.com/api/v2", "path": "/channels", "finalUrl": "https://cliq.zoho.com/api/v2/channels" },
      { "baseUrl": "https://crm.zoho.com/crm/v5",  "path": "/Leads",    "finalUrl": "https://crm.zoho.com/crm/v5/Leads" },
      { "baseUrl": "https://desk.zoho.eu/api/v1",  "path": "/tickets",  "finalUrl": "https://desk.zoho.eu/api/v1/tickets" }
    ],
    "adr": "ADR-0003 — no product-to-subdomain derivation; no stale mapping to maintain; AI agent has full control"
  },
  "traceStorage": {
    "layout": "<configDir>/traces/sessions.json  (index)\n<configDir>/traces/<session-name>/trace.jsonl  (append-only entries)",
    "activeSessionBehavior": "api call auto-appends to active session — no --trace flag needed",
    "noActiveBehavior": "Trace entries silently dropped — no error, no implicit session created",
    "authHeaderRule": "TraceWriter ALWAYS excludes Authorization from requestHeaders before writing",
    "sessionNaming": "Names validated — allow only [a-zA-Z0-9_.-], max 64 chars — INVALID_ARGS if violated"
  },
  "storageFiles": {
    "accounts":          "<configDir>/accounts.json",
    "registry":          "<configDir>/registry.json (v2)",
    "pexBuffer":         "<configDir>/pex-buffer/<account>.jsonl (v2)",
    "traceIndex":        "<configDir>/traces/sessions.json",
    "traceEntries":      "<configDir>/traces/<session-name>/trace.jsonl",
    "keychainFallback":  "<configDir>/keystore/<accountName>.bin"
  }
}
