# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.
#
# Used by: zapi-cli account mobile-login
#   ZOHO_CLIENT_ID      — falls back to this when --client-id is not passed
#   ZOHO_CLIENT_SECRET  — falls back to this when --client-secret is not passed
#
# Example usage once set:
#   zapi-cli account mobile-login --name myaccount --scope "ZohoMail.messages.READ" --dc in

ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
